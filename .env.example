# Copy to .env.local and fill in. .env.local is git-ignored.
# Only VITE_ variables reach the browser, so they must be non-secret.

VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_MOCK_MODE=true

# SERVER-ONLY secrets. Never put these in a .env file the frontend reads.
# Set them with:  supabase secrets set NAME=value
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# ANTHROPIC_API_KEY=
